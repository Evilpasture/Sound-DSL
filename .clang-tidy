---
# Enabled categories: bugprone, performance, and readability
Checks: >-
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  performance-*,
  -performance-avoid-endl,
  readability-*,
  -readability-identifier-length,
  -readability-magic-numbers,
  -readability-braces-around-statements,
  -readability-function-cognitive-complexity,
  -readability-uppercase-literal-suffix

WarningsAsErrors: ""
HeaderFilterRegex: '.*'

CheckOptions:
  - key:             modernize-use-auto.MinTypeNameLength
    value:           '3'
  - key:             bugprone-suspicious-include.HeaderFileExtensions
    value:           'h,hpp,hh'
  # Allow single-letter variables for math (i, t, f, d)
  - key:             readability-identifier-length.MinimumVariableNameLength
    value:           '1'
  - key:             readability-identifier-length.MinimumConstantNameLength
    value:           '1'
  # Ensure macro parameters are parenthesized to protect the DSL
  - key:             bugprone-macro-parentheses.CheckOptional
    value:           'true'
---